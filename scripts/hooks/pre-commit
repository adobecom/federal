#!/bin/sh
# Pre-commit hook: keeps built global-navigation artifacts OUT of feature commits.
# Installed automatically via the `prepare` npm script in the repo root.
#
# The committed bundle (federal/libs/global-navigation/dist/) is owned by CI:
# the `rebuild-dist` workflow rebuilds and commits it on every push to
# `stage` and `main`. Feature branches must never modify it, otherwise every
# PR carries its own build of the same file and conflicts on merge.
#
# You can (and should) still run `npm run build` locally to test — this hook
# just makes sure that throwaway build never sneaks into a commit.

set -e

GNAV_DIST="federal/libs/global-navigation/dist"

# Anything from dist/ that got staged? Unstage it, leaving your working-tree
# build untouched so local testing still works.
STAGED_DIST=$(git diff --cached --name-only -- "$GNAV_DIST" || true)

if [ -n "$STAGED_DIST" ]; then
  echo "note: unstaging global-navigation build artifacts — CI owns dist/."
  echo "$STAGED_DIST" | sed 's/^/  - /'
  git restore --staged -- "$GNAV_DIST"
fi

exit 0
